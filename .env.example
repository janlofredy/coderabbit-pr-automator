# GitHub Personal Access Token (classic with 'repo' scope or fine-grained)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Comma-separated list of GitHub repositories to monitor
REPOSITORIES=cictd-isds/chrmd-web,cictd-isds/chrmd-api

# Interval between polling cycles (seconds)
POLL_INTERVAL_SECONDS=900

# File limit guard (skips PRs modifying more files than this)
MAX_FILES_LIMIT=100

# Enable automated review approval on clean PRs
AUTO_APPROVE=true

# Strict approval: if true, any minor issue or warning prevents approval
STRICT_APPROVAL=true

# Optional CodeRabbit API Key
CODERABBIT_API_KEY=

# Web Dashboard Port
PORT=8765
