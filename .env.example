# ==============================================================================
# CodeRabbit Auto-Reviewer Environment Configuration
# ==============================================================================

# Required: GitHub Personal Access Token with 'repo' scope
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Comma-separated list of default GitHub repositories to monitor
REPOSITORIES=cictd-isds/chrmd-web,cictd-isds/chrmd-api

# Polling interval in seconds (default: 900 seconds / 15 minutes)
POLL_INTERVAL_SECONDS=900

# Maximum file count threshold for CodeRabbit Free Tier (default: 100)
MAX_FILES_LIMIT=100

# Automatically submit APPROVE review on PRs with 0 critical/major issues (default: true)
AUTO_APPROVE=true

# Optional: CodeRabbit CLI API Key (Alternative to mounting ~/.coderabbit/auth.json)
CODERABBIT_API_KEY=

# Optional: Web Dashboard Port (default: 8765)
PORT=8765
