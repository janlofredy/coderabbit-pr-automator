# ==============================================================================
# CodeRabbit PR Auto-Reviewer Environment Variables
# ==============================================================================
# Only GITHUB_TOKEN is required as an environment variable!
# All other settings (monitored repositories, polling interval, max files limit,
# auto-approval, strict approval, and optional CodeRabbit API key) are stored in
# the persistent configuration file (config.json) and can be modified live at
# runtime from the Web Dashboard at http://<your-server>:8765.
# ==============================================================================

# GitHub Personal Access Token (classic with 'repo' scope or fine-grained)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
